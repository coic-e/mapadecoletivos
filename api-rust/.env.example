# Database Configuration
DATABASE_URL=postgresql://docker:SENHA_DO_BANCO@localhost:5432/rave_map

# Server Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# File Upload Configuration
# Teto por imagem (5 MB). Só JPEG, PNG, GIF e WebP passam: o formato é
# conferido nos bytes do arquivo, não na extensão nem no que o cliente declara.
MAX_FILE_SIZE=5242880
# Imagens por cadastro, campos de texto e corpo inteiro da requisição.
MAX_FILES_PER_REQUEST=6
MAX_FIELD_SIZE=16384
MAX_REQUEST_SIZE=33554432

# Base URL for serving images (configurable per environment)
BASE_URL=http://localhost:8080

# Origens autorizadas a chamar a API pelo navegador, separadas por vírgula.
# Em produção, o domínio do site. "*" é recusado.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Logging
RUST_LOG=info

# Auth dos moderadores.
# JWT_SECRET precisa de ao menos 32 caracteres e não pode ser um dos exemplos
# do repositório — a API recusa subir. Gere: openssl rand -base64 48
JWT_SECRET=
JWT_TTL_HOURS=8

# Rate limit: tentativas por IP dentro da janela (em segundos).
LOGIN_RATE_LIMIT=5
SUBMISSION_RATE_LIMIT=10
RATE_LIMIT_WINDOW_SECS=300

# Só ligue atrás de um proxy que reescreve X-Forwarded-For.
TRUST_PROXY=false

# Bucket das imagens. MinIO local pelo compose; S3/R2/Spaces em producao.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=rave-map
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=http://localhost:9000/rave-map
S3_REGION=us-east-1
