# Variáveis lidas pelo docker-compose. Copie para .env (que é ignorado pelo
# git) e preencha. Nenhum segredo real entra neste arquivo de exemplo.

# Senha do Postgres. Gere uma: openssl rand -base64 24
POSTGRES_PASSWORD=

# Assina os tokens dos moderadores. Precisa de pelo menos 32 caracteres, e a
# API recusa subir com os segredos de exemplo que circulam no repositório.
# Gere um: openssl rand -base64 48
JWT_SECRET=

# Validade do token, em horas.
JWT_TTL_HOURS=8

# URL pública da API, usada para montar o endereço das imagens.
BASE_URL=http://localhost:8080

# Origens autorizadas a chamar a API pelo navegador, separadas por vírgula.
# Em produção, o domínio do site. Nunca "*".
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Ligue apenas se houver um proxy reverso reescrevendo X-Forwarded-For. Ligado
# sem proxy, qualquer cliente forja o próprio IP e escapa do rate limit.
TRUST_PROXY=false

# Bucket das imagens (MinIO local; S3/R2/Spaces em producao)
S3_BUCKET=rave-map
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_BASE_URL=http://localhost:9000/rave-map
S3_REGION=us-east-1
