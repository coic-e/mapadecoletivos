# Mapbox Configuration
# Get your credentials from https://account.mapbox.com/
VITE_USERNAME=your_mapbox_username
VITE_STYLE_ID=your_mapbox_style_id
VITE_ACCESS_TOKEN=your_mapbox_access_token

# API Configuration
# URL da API. Fora de localhost precisa ser https: em pagina https, uma API em
# http e bloqueada como conteudo misto e o token do moderador viajaria aberto.
VITE_API_URL=http://localhost:8080
# Site
# URL absoluta de produção: usada em canonical, Open Graph, robots.txt e sitemap.xml
VITE_SITE_URL=https://seu-dominio.com.br
