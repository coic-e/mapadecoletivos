# Mapbox Configuration
# Get your credentials from https://account.mapbox.com/
VITE_MAPBOX_USERNAME=your_mapbox_username
VITE_MAPBOX_STYLE_ID=your_mapbox_style_id
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token

# API Configuration
# URL da API. Fora de localhost precisa ser https: em pagina https, uma API em
# http e bloqueada como conteudo misto e o token do moderador viajaria aberto.
VITE_API_URL=http://localhost:8080
# Site
# URL absoluta: usada em canonical, Open Graph, JSON-LD, robots.txt e sitemap.xml.
# Sem barra no fim. Ausente, o build usa este mesmo valor.
VITE_SITE_URL=https://mapaderave.com.br

# Origem publica do bucket de imagens. Precisa constar no CSP, senao o
# navegador bloqueia as fotos dos cadastros.
VITE_IMAGES_BASE_URL=http://localhost:9000
